include LICENCE RELEASE-NOTES AUTHORS
include README.md
include electrum-ravencoin.desktop
include *.py
include run_electrum
include org.electrum.electrum.metainfo.xml
# Ship the bundled dependencies whole.  Selecting only *.py silently dropped the
# data files some dependencies read at import time, for example
# packages/multiformats_config/multicodec-table.json, which made the source
# distribution fail to start at all.  The complete set of non-Python files is
# about 3.6 MB, so correctness is worth far more than the size saving.
graft packages

include contrib/requirements/requirements*.txt
include contrib/deterministic-build/requirements*.txt
include contrib/*.sh

graft electrum
prune electrum/tests
graft contrib/udev

exclude electrum/*.so
exclude electrum/*.so.0
exclude electrum/*.dll
exclude electrum/*.dylib

global-exclude __pycache__
global-exclude *.py[co~]
# setuptools console-script launcher stubs, meaningless in a source distribution
global-exclude *.exe
global-exclude *.py.orig
global-exclude *.py.rej
global-exclude .git

# Maybe we should exclude the compiled locale files? see https://askubuntu.com/a/144139
# We include both source (.po) and compiled (.mo) locale files atm (if present).
# exclude electrum/locale/*/LC_MESSAGES/electrum.mo
